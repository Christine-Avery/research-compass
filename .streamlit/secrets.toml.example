# Template only. Copy to ignored secrets.toml locally or paste privately into
# Streamlit Community Cloud Secrets. Never commit real credentials.
OPENALEX_API_KEY = "replace-with-your-free-openalex-key"
DASHSCOPE_API_KEY = "replace-with-your-dashscope-key"
DASHSCOPE_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL = "qwen3.8-flash"

# Configure these only after the persistent-budget security review passes.
PUBLIC_DEPLOYMENT = false
PUBLIC_QWEN_ENABLED = false
PUBLIC_QWEN_SECURITY_REVIEW_PASSED = false
UPSTASH_REDIS_REST_URL = "https://replace-with-your-upstash-endpoint"
UPSTASH_REDIS_REST_TOKEN = "replace-with-your-upstash-rest-token"
PUBLIC_BUDGET_HMAC_KEY = "replace-with-a-random-secret-at-least-32-bytes"
